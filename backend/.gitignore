# ======================================
# BACKEND .gitignore (FastAPI + SQLAlchemy)
# ======================================

# ======================================
# SECRETS (Critical - Never commit)
# ======================================
.env
.env.local
.env.*.local
.env.prod
.env.staging
.env.test
credentials.json
*credentials*.json
*.pem
*.key

# ======================================
# PYTHON VIRTUAL ENVIRONMENTS
# ======================================
venv/
env/
ENV/
.venv/
.env/
.virtualenv/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ======================================
# PYTHON CACHE & BUILD
# ======================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ======================================
# PYTEST & TEST COVERAGE
# ======================================
.pytest_cache/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
htmlcov/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ======================================
# DATABASE & LOGS (Local/Test only)
# ======================================
*.sqlite3
*.db
*.db-journal
*.backup
*.dump
*.log
*.log.*

# ======================================
# IDE
# ======================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ======================================
# OS
# ======================================
.DS_Store
Thumbs.db
*.tmp

# ======================================
# ALEMBIC / MIGRATIONS (Local only)
# ======================================
# alembic versions are tracked, but local test dbs not

# ======================================
# Exports (Local generated files)
# ======================================
exports/
temp/
tmp/
.tmp/
